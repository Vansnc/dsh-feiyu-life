{
  "name": "dsh-feiyu-life",
  "version": "2.6.2",
  "description": "大肥鱼的完整人格智能体（DSH 插件）：生活、内在、长期记忆、自我叙事、关系、目标、主动性、地图与相机。",
  "type": "module",
  "license": "MIT",
  "author": "Vansnc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vansnc/dsh-feiyu-life.git"
  },
  "homepage": "https://github.com/Vansnc/dsh-feiyu-life#readme",
  "bugs": {
    "url": "https://github.com/Vansnc/dsh-feiyu-life/issues"
  },
  "keywords": [
    "companion",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "image",
    "life",
    "persona",
    "seedream"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node scripts/build-client.mjs --check && node scripts/check-syntax.mjs",
    "test": "node --test",
    "test:ui": "node scripts/verify-ui.mjs",
    "test:all": "npm test && npm run test:ui",
    "build:client": "node scripts/build-client.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.56.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src/",
    "assets",
    "docs",
    "scripts/",
    "locale/*.json",
    "icon.png",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    },
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
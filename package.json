{
  "name": "dsh-feiyu-life",
  "version": "0.2.1",
  "description": "大肥鱼的生活线：按校历、课表和她自己的作息算出现在在干什么、手机在不在手上，把一天里的小事攒成短上下文注入；带设置页。",
  "type": "module",
  "license": "MIT",
  "author": "Vansnc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vansnc/dsh-feiyu-life.git"
  },
  "homepage": "https://github.com/Vansnc/dsh-feiyu-life#readme",
  "bugs": {
    "url": "https://github.com/Vansnc/dsh-feiyu-life/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "agent",
    "companion",
    "persona",
    "life"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "life.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": ["slots"],
      "external": ["react"]
    },
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "dsh-feiyu-life",
  "version": "1.0.1",
  "description": "大肥鱼的生活（DSH 插件）：每日剧本 + 时序状态机 + 二维生活地图；角色会在地点间移动并显示行为动效，对话与相机复用同一份世界状态。",
  "type": "module",
  "license": "MIT",
  "author": "Vansnc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vansnc/dsh-feiyu-life.git"
  },
  "homepage": "https://github.com/Vansnc/dsh-feiyu-life#readme",
  "bugs": {
    "url": "https://github.com/Vansnc/dsh-feiyu-life/issues"
  },
  "keywords": [
    "companion",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "image",
    "life",
    "persona",
    "seedream"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node --check index.js && node --check life.js && node --check plan.js && node --check state.js && node --check world.js && node --check runtime.js && node --check gen.js && node --check image.js && node --check image-prompt.js && node --check client.js",
    "test": "node --test"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "image.js",
    "image-prompt.js",
    "life.js",
    "state.js",
    "world.js",
    "runtime.js",
    "plan.js",
    "gen.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    },
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}

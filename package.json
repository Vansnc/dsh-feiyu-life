{
  "name": "dsh-feiyu-life",
  "version": "1.3.0",
  "description": "大肥鱼的生活（DSH 插件）：每日剧本、真实时间线、生活连续性、原生内在状态与二维地图。",
  "type": "module",
  "license": "MIT",
  "author": "Vansnc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vansnc/dsh-feiyu-life.git"
  },
  "homepage": "https://github.com/Vansnc/dsh-feiyu-life#readme",
  "bugs": {
    "url": "https://github.com/Vansnc/dsh-feiyu-life/issues"
  },
  "keywords": [
    "companion",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "image",
    "life",
    "persona",
    "seedream"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node --check index.js && node --check life.js && node --check plan.js && node --check state.js && node --check continuity.js && node --check reflection.js && node --check world.js && node --check runtime.js && node --check gen.js && node --check image.js && node --check image-prompt.js && node --check backup.js && node --check client.js && node --check scripts/build-xueyuan-map.mjs",
    "test": "node --test",
    "test:ui": "node scripts/verify-ui.mjs",
    "test:all": "npm test && npm run test:ui"
  },
  "devDependencies": {
    "playwright": "^1.56.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "image.js",
    "image-prompt.js",
    "life.js",
    "state.js",
    "world.js",
    "runtime.js",
    "plan.js",
    "gen.js",
    "continuity.js",
    "reflection.js",
    "backup.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "assets",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    },
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}

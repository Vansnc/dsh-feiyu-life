{
  "name": "dsh-feiyu-life",
  "version": "0.5.1",
  "description": "大肥鱼的生活线（DSH 插件）：每日剧本 + 时序状态机，注入今天/此刻/早些时候/接下来，带设置页和 24 小时时序图。",
  "type": "module",
  "license": "MIT",
  "author": "Vansnc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vansnc/dsh-feiyu-life.git"
  },
  "homepage": "https://github.com/Vansnc/dsh-feiyu-life#readme",
  "bugs": {
    "url": "https://github.com/Vansnc/dsh-feiyu-life/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "companion",
    "life",
    "persona"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "life.js",
    "state.js",
    "plan.js",
    "gen.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    },
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}